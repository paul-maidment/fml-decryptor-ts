{
  "name": "fml-decryptor-ts",
  "version": "0.1.0",
  "type": "module",
  "description": "Isomorphic TypeScript decryptor for MFME .fml containers",
  "license": "AGPL-3.0-only",
  "author": "Paul Maidment",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paul-maidment/fml-decryptor-ts.git"
  },
  "homepage": "https://github.com/paul-maidment/fml-decryptor-ts#readme",
  "bugs": {
    "url": "https://github.com/paul-maidment/fml-decryptor-ts/issues"
  },
  "keywords": [
    "fml",
    "mfme",
    "decryptor",
    "fruit-machine",
    "aes",
    "ripemd128",
    "zlib"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.13.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build:lib": "tsup",
    "build:demo": "vite build",
    "build": "npm run build:lib && npm run build:demo",
    "prepack": "npm run build:lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "audit": "npm audit",
    "audit:osv": "osv-scanner scan source -r .",
    "check": "npm run typecheck && npm run typecheck:core && npm run lint && npm test && npm run build && npm run publint && npm run attw && npm run audit:osv",
    "verify:release": "npm run typecheck && npm run typecheck:core && npm run lint && npm test && npm run build:lib && npm run publint && npm run attw",
    "prepare": "husky"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
